# ───────── Hardware Store — environment template ─────────
# Copy to .env (per app/package) and fill in. NEVER commit real secrets.

# Database — online hosted Postgres (Neon / Supabase / Railway / RDS …)
# DATABASE_URL = POOLED connection (PgBouncer) — used by the app at runtime.
# DIRECT_URL   = DIRECT (non-pooled) connection — used only for migrations.
# If your provider has no separate pooler, set both to the same URL.
DATABASE_URL="postgresql://USER:PASS@POOLED-HOST:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@DIRECT-HOST:5432/dbname?sslmode=require"

# Auth.js (generate: openssl rand -base64 32)
AUTH_SECRET=""

# Upstash — rate-limit store (auth) + jobs queue
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
CRON_SECRET=""

# Razorpay — DISABLED for now (online payment removed from checkout; orders are
# pay-at-store / on-delivery). Leave blank. To re-enable later, restore the payment
# selector in apps/storefront/app/checkout/page.tsx and fill TEST keys here.
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""

# Cloudinary — product photos. Browser-side UNSIGNED upload from the admin app
# (staff-only). Create an unsigned upload preset in the Cloudinary dashboard
# (Settings → Upload → Upload presets → Signing Mode: Unsigned). Both are public
# (NEXT_PUBLIC_*, inlined at build) and only the ADMIN app needs them; the storefront
# just renders the stored delivery URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Cloudflare R2 (signed URLs + encrypted DB backups; product images now use Cloudinary)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="dev-hardware"
# Symmetric passphrase for the encrypted pg_dump backup (S7 backup job). When unset,
# the backup job degrades to runtime-deferred (no dump is taken).
BACKUP_ENCRYPTION_PASSPHRASE=""

# Email / SMS (order-status + khata dues reminders via Resend; SMS where DLT approved)
RESEND_API_KEY=""
RESEND_FROM="orders@hardware.local"
RESEND_TEST_TO="customer@example.com"
MSG91_AUTH_KEY=""

# Observability
SENTRY_DSN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
