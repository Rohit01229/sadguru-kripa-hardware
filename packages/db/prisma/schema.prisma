// Hardware Store — Prisma schema (FULL model).
// Source of truth: docs/architecture/13-data-architecture.md.
// Foundation subset (auth realms + RBAC + audit + UoM core + counters + StoreConfig)
// grown to the full 13 model in slice S0: PriceSlab, Batch, Reservation,
// Supplier/GoodsReceipt/GrnLine/SupplierPayment, Address, LedgerEntry,
// Invoice/InvoiceLine/Payment, CreditNoteCounter/CreditNote/CreditNoteLine,
// Order/OrderLine, ProcessedWebhook.
//
// MULTI-TENANCY (P0 — docs/architecture/17): every business row carries a `shopId`
// (a bare indexed scalar — NO Prisma relation and NO DB-level FK, so the schema stays
// the single source of truth with no drift and models stay clean; tenant integrity is
// guaranteed by trusted server code, which only ever sets `shopId` from a validated
// session). `shopId` is NOT NULL on every business table (exceptions: ProcessedWebhook
// and IdempotencyKey — operational tables set at times when no shop is in scope).
// Global uniques are composite per shop (`@@unique([shopId, sku|name|code|…])`), and
// StoreConfig + the invoice/credit-note counters are keyed per shop. Applied to the DB
// via a two-step migration (expand: add nullable column + backfill Shop #1; contract:
// NOT NULL + composite constraints) — see docs/architecture/17 §5.

generator client {
  provider        = "prisma-client-js"
  // Vercel's serverless Node runtime is rhel-openssl-3.0.x. Generate that engine in
  // addition to `native` (the local/CI build platform) so the deployed function has a
  // matching Query Engine binary — otherwise Prisma throws "could not locate the Query
  // Engine for runtime rhel-openssl-3.0.x" at runtime. Pairs with the next.config
  // outputFileTracing* settings that copy the .so into the serverless bundle.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  // relationJoins: lets reads pass `relationLoadStrategy: "join"` so a Product +
  // brand/baseUnit/saleUnits/stock projection resolves in ONE SQL JOIN instead of
  // fanning out into N sequential Neon round-trips (perf — catalog/getProduct).
  // GA-promoted strategy still gated behind this preview flag at client-generation
  // time in Prisma 6.x. NOTE: requires `prisma generate` to take effect; until the
  // client is regenerated, core falls back to the default (multi-query) strategy
  // automatically (see packages/core/src/shared/db.ts joinStrategy()), so the
  // running app is unaffected by adding this flag.
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

// ───────────────────────── Enums ─────────────────────────
enum UnitKind {
  MEASURED // length / weight / volume → decimals allowed
  PIECE //    whole numbers only
}

enum CustomerType {
  RETAIL
  WHOLESALE
}

enum MovementKind {
  GRN_IN
  SALE_OUT
  KACHA_OUT
  ADJUST_IN
  ADJUST_OUT
  SALES_RETURN_IN
  PURCHASE_RETURN_OUT
  ORDER_DISPATCH_OUT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONVERTED
  EXPIRED
}

enum LedgerEntryType {
  INVOICE_DEBIT
  PAYMENT_CREDIT
  CREDIT_NOTE_CREDIT
  OPENING
  ADJUSTMENT
}

enum InvoiceStatus {
  ACTIVE
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI
  CARD
  CREDIT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAY_LATER
  CONFIRMED
  PACKED
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum FulfilmentType {
  DELIVERY
  PICKUP
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

// ──────────────────── Tenant root: SHOP ────────────────────
// The tenant. The platform super-admin creates one Shop per hardware store; every
// business row carries this shop's id. `slug` is the future routing key
// (subdomain/path). `plan`/`status` are lightweight placeholders until the full
// Plan/Subscription models arrive (P4).
model Shop {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED
  plan      String   @default("FREE") // placeholder until Plan/Subscription (P4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────── Auth realm: PLATFORM (super-admin) ────────────────────
// The operator of the SaaS — you. A THIRD realm, deliberately separate from shop
// staff and storefront customers (16 §5e): its own table, its own cookie, its own
// session rows. A platform session can never satisfy a shop guard and vice-versa,
// so a compromised shop login can never reach the console that creates shops.
//
// Platform users are NOT scoped to a shopId — that is the whole point: they act
// across tenants. Every cross-tenant action they take is audited.
model PlatformUser {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  name         String
  status       String            @default("ACTIVE") // ACTIVE | DISABLED
  /// SUPER_ADMIN can create/suspend shops; SUPPORT is read-only + impersonate.
  role         String            @default("SUPER_ADMIN")
  sessions     PlatformSession[]
  lastLoginAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model PlatformSession {
  id             String       @id @default(cuid())
  platformUserId String
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([platformUserId])
}

// ──────────────────── Auth realm: STAFF ────────────────────
model StaffUser {
  id            String         @id @default(cuid())
  shopId        String // the shop this staff user belongs to (NOT NULL after contract)
  email         String         @unique
  passwordHash  String
  name          String
  status        String         @default("ACTIVE") // ACTIVE | DISABLED
  emailVerified DateTime?
  roles         UserRole[]
  sessions      StaffSession[]
  pins          StaffPin[]
  totp          StaffTotp?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([shopId])
}

model StaffSession {
  id          String    @id @default(cuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([staffUserId])
}

model StaffTotp {
  staffUserId   String    @id
  staffUser     StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  secretEnc     String // encrypted at rest
  recoveryCodes String[] // hashed
  enabled       Boolean   @default(false) // scaffolded, off in v1
}

// ──────────────────── Device PIN (fast re-login) ────────────────────
// A shopkeeper cannot type a full password twenty times a day on a counter tablet, and
// SMS OTP costs money per login and needs DLT approval before it can send anything. So:
// password ONCE per device, then a 4-digit PIN.
//
// SECURITY MODEL — the PIN is never an authenticator on its own. It is only accepted
// alongside a device token this row was created for, so it is genuinely two factors:
// the device (something you have) and the PIN (something you know). A leaked 4-digit PIN
// is useless without the device cookie, and a stolen device cookie is useless without
// the PIN. Both are stored HASHED; neither is recoverable from the database.
//
// 4 digits is only 10,000 combinations, so the attempt counter below is load-bearing,
// not a nicety: it locks the PIN after a few misses and forces a full password sign-in.
model StaffPin {
  id          String    @id @default(cuid())
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque device token held in the `hw.device` cookie. Unique, so one
  /// row per device, and the raw token never touches the database.
  deviceHash  String    @unique
  /// argon2id, exactly like a password — a 4-digit PIN is low-entropy, so it must never
  /// be stored in a form that a database leak could reverse.
  pinHash     String
  /// Shown when managing devices, e.g. "Counter tablet".
  label       String?
  failedCount Int       @default(0)
  /// Set once failedCount trips the limit; the PIN is refused until a password sign-in.
  lockedUntil DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([staffUserId])
}

// ──────────────────── Auth realm: CUSTOMER ────────────────────
model Customer {
  id          String           @id @default(cuid())
  shopId      String // the shop this customer belongs to (NOT NULL after contract)
  name        String
  phone       String?
  gstin       String?
  type        CustomerType     @default(RETAIL)
  creditLimit Decimal?         @db.Decimal(14, 2)
  account     CustomerAccount?
  addresses   Address[]
  invoices    Invoice[]
  orders      Order[]
  ledger      LedgerEntry[]
  salesDocs   SalesDoc[]
  createdAt   DateTime         @default(now())

  @@index([phone])
  @@index([shopId])
}

model CustomerAccount {
  id            String            @id @default(cuid())
  customerId    String            @unique
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  email         String            @unique
  passwordHash  String
  emailVerified DateTime?
  sessions      CustomerSession[]
  createdAt     DateTime          @default(now())
}

model CustomerSession {
  id        String          @id @default(cuid())
  accountId String
  account   CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime        @default(now())

  @@index([accountId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  realm     String // STAFF | CUSTOMER
  subjectId String
  purpose   String // EMAIL_VERIFY | PASSWORD_RESET
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([subjectId, purpose])
}

// ──────────────────────── RBAC ────────────────────────
model Permission {
  id    String           @id @default(cuid())
  key   String           @unique // e.g. "bill.pakka.create"
  roles RolePermission[]
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // OWNER | (future) CASHIER ...
  label       String
  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  staffUserId String
  roleId      String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffUserId, roleId])
}

// ──────────────────────── Audit ────────────────────────
model AuditLog {
  id             String   @id @default(cuid())
  shopId         String // tenant scope (NOT NULL after contract; SYSTEM jobs derive it per row)
  actorStaffId   String?
  roleAtTime     String?
  permissionUsed String?
  action         String
  targetType     String?
  targetId       String?
  before         Json?
  after          Json?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([shopId])
}

// ──────────────────── Catalog & Unit-of-Measure ────────────────────
model Category {
  id       String     @id @default(cuid())
  shopId   String
  name     String
  parentId String?
  parent   Category?  @relation("Sub", fields: [parentId], references: [id])
  children Category[] @relation("Sub")
  products Product[]

  @@index([shopId])
}

model Brand {
  id       String    @id @default(cuid())
  shopId   String
  name     String
  products Product[]

  @@unique([shopId, name])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Brand_name_trgm_idx", type: Gin)
  @@index([shopId])
}

model Unit {
  id           String            @id @default(cuid())
  shopId       String
  code         String // "m","coil","L","bucket","pc","box","kg","bag"
  name         String
  kind         UnitKind
  baseProducts Product[]         @relation("BaseUnit")
  saleUnits    ProductSaleUnit[]

  @@unique([shopId, code])
  @@index([shopId])
}

model Product {
  id              String            @id @default(cuid())
  shopId          String
  sku             String
  name            String
  brandId         String?
  brand           Brand?            @relation(fields: [brandId], references: [id])
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id])
  hsnCode         String?
  barcode         String? // scanned EAN/UPC or shop-printed label (optional; not unique)
  baseUnitId      String
  baseUnit        Unit              @relation("BaseUnit", fields: [baseUnitId], references: [id])
  costPerBaseUnit Decimal           @db.Decimal(14, 2)
  gstRate         Decimal           @db.Decimal(5, 2)
  priceInclusive  Boolean           @default(false)
  imageKeys       String[]
  reorderLevel    Decimal?          @db.Decimal(14, 3)
  trackExpiry     Boolean           @default(false)
  allowNegative   Boolean           @default(false)
  availableOnline Boolean           @default(true)
  isActive        Boolean           @default(true)
  saleUnits       ProductSaleUnit[]
  batches         Batch[]
  stock           ProductStock?
  movements       StockMovement[]
  salesDocLines   SalesDocLine[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([shopId, sku])
  @@index([categoryId])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Product_name_trgm_idx", type: Gin)
  @@index([sku(ops: raw("gin_trgm_ops"))], map: "Product_sku_trgm_idx", type: Gin)
  @@index([shopId])
  @@index([shopId, barcode])
}

model ProductSaleUnit {
  id           String      @id @default(cuid())
  shopId       String
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit        @relation(fields: [unitId], references: [id])
  factorToBase Decimal     @db.Decimal(18, 6) // baseQty = saleQty × factorToBase
  mrp          Decimal?    @db.Decimal(14, 2)
  salePrice    Decimal     @db.Decimal(14, 2)
  isDefault    Boolean     @default(false)
  priceSlabs   PriceSlab[]

  @@unique([productId, unitId])
  @@index([shopId])
}

model ProductStock {
  productId String   @id
  shopId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  onHand    Decimal  @default(0) @db.Decimal(14, 3) // base units
  reserved  Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt DateTime @updatedAt

  @@index([shopId])
}

model StockMovement {
  id           String       @id @default(cuid())
  shopId       String
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  batchId      String? // FK added with Batch model later
  baseQty      Decimal      @db.Decimal(14, 3) // signed: + in, − out
  kind         MovementKind
  refType      String? // INVOICE | GRN | ORDER | ADJUSTMENT | CN
  refId        String?
  reason       String?
  actorStaffId String?
  createdAt    DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([kind])
  @@index([shopId])
}

// ──────────────────── Counters & settings ────────────────────
model InvoiceCounter {
  // Gapless invoice sequence, now PER SHOP (17). The composite PK is the row the
  // `UPDATE … RETURNING` locks, so each shop has an independent, gapless series.
  shopId String
  fy     String // "2026-27"
  lastNo Int    @default(0)

  @@id([shopId, fy])
}

model CreditNoteCounter {
  shopId String
  fy     String // "2026-27" — own gapless series per shop (13 §8, 17)
  lastNo Int    @default(0)

  @@id([shopId, fy])
}

model StoreConfig {
  // One row per shop (17). `id` stays the PK (cuid); `shopId` is the lookup key.
  id                    String    @id @default(cuid())
  shopId                String    @unique
  name                  String
  gstin                 String?
  homeState             String // intra/inter-state decision (03 §8)
  address               String?
  logoKey               String?
  bankDetails           String?
  invoiceTerms          String?
  invoicePrefixFormat   String    @default("{FY}/{SEQ6}")
  deliveryFlatFee       Decimal   @default(0) @db.Decimal(14, 2)
  freeDeliveryThreshold Decimal?  @db.Decimal(14, 2)
  reservationTtlMinutes Int       @default(30)
  gstRoundingMode       String    @default("PER_INVOICE")
  /// Shop phone, printed on bills when the theme's "show contact" toggle is on.
  /// Without this the toggle had nothing to render (19 §7).
  phone                 String?
  /// Set when the owner finishes (or skips) the first-run wizard — 16 §6. Null means
  /// "never onboarded", which is what routes them to /welcome on first sign-in. An
  /// explicit stamp, not inferred from having products, so skipping stays skipped.
  onboardedAt           DateTime?
  /// Bill theme JSON (19 §7) — colours/fonts/toggles for printed bills. Cosmetic
  /// only: GST-mandatory elements are not expressible as hideable. Null = defaults.
  billTheme             Json?
}

// ──────────────────── Pricing & batches (13 §4) ────────────────────
model PriceSlab {
  // quantity-break (bulk) pricing on a sale unit
  id               String          @id @default(cuid())
  shopId           String
  saleUnitId       String
  saleUnit         ProductSaleUnit @relation(fields: [saleUnitId], references: [id], onDelete: Cascade)
  minQty           Decimal         @db.Decimal(14, 3)
  pricePerSaleUnit Decimal         @db.Decimal(14, 2)

  @@index([saleUnitId, minQty])
  @@index([shopId])
}

model Batch {
  // batch + optional expiry / MRP-wise on-hand for FIFO/expiry
  id         String    @id @default(cuid())
  shopId     String
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  code       String
  mrp        Decimal?  @db.Decimal(14, 2)
  mfgDate    DateTime?
  expiryDate DateTime?
  onHand     Decimal   @default(0) @db.Decimal(14, 3) // base units

  @@unique([productId, code])
  @@index([expiryDate])
  @@index([shopId])
}

// ──────────────────── Reservations (13 §5) ────────────────────
model Reservation {
  id        String            @id @default(cuid())
  shopId    String
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  baseQty   Decimal           @db.Decimal(14, 3)
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  @@index([status, expiresAt])
  @@index([productId])
  @@index([shopId])
}

// ──────────────────── Suppliers & purchasing (13 §6) ────────────────────
model Supplier {
  id        String            @id @default(cuid())
  shopId    String
  name      String
  gstin     String?
  phone     String?
  address   String?
  receipts  GoodsReceipt[]
  payments  SupplierPayment[]
  createdAt DateTime          @default(now())

  @@index([shopId])
}

model GoodsReceipt {
  // GRN
  id          String    @id @default(cuid())
  shopId      String
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  refNo       String?
  date        DateTime  @default(now())
  note        String?
  lines       GrnLine[]
  createdById String?

  @@index([shopId])
}

model GrnLine {
  id              String       @id @default(cuid())
  shopId          String
  grnId           String
  grn             GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  productId       String
  batchId         String?
  baseQty         Decimal      @db.Decimal(14, 3)
  costPerBaseUnit Decimal      @db.Decimal(14, 2)

  @@index([shopId])
}

model SupplierPayment {
  // payables [N]
  id         String   @id @default(cuid())
  shopId     String
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Decimal  @db.Decimal(14, 2)
  mode       String
  date       DateTime @default(now())

  @@index([shopId])
}

// ──────────────────── Parties: addresses & khata ledger (13 §7) ────────────────────
model Address {
  id         String   @id @default(cuid())
  shopId     String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  line1      String
  line2      String?
  city       String
  state      String // place-of-supply driver (03 §8)
  pincode    String
  isDefault  Boolean  @default(false)

  @@index([shopId])
}

model LedgerEntry {
  id         String          @id @default(cuid())
  shopId     String
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id])
  type       LedgerEntryType
  amount     Decimal         @db.Decimal(14, 2) // + debit / − credit by convention
  refType    String? // INVOICE | PAYMENT | CN
  refId      String?
  note       String?
  createdAt  DateTime        @default(now())

  @@index([customerId, createdAt])
  @@index([shopId])
}

// ──────────────────── Billing & GST (13 §8) ────────────────────
model Invoice {
  id                 String        @id @default(cuid())
  shopId             String
  fy                 String // "2026-27"
  invoiceNo          String // "2026-27/000124"
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id])
  customerNameSnap   String? // walk-in / snapshot
  customerGstinSnap  String?
  placeOfSupplyState String
  date               DateTime      @default(now())
  taxableTotal       Decimal       @db.Decimal(14, 2)
  discountTotal      Decimal       @default(0) @db.Decimal(14, 2)
  cgstTotal          Decimal       @default(0) @db.Decimal(14, 2)
  sgstTotal          Decimal       @default(0) @db.Decimal(14, 2)
  igstTotal          Decimal       @default(0) @db.Decimal(14, 2)
  roundOff           Decimal       @default(0) @db.Decimal(14, 2)
  grandTotal         Decimal       @db.Decimal(14, 2)
  status             InvoiceStatus @default(ACTIVE)
  cancelledReason    String?
  orderId            String?       @unique // set when generated from an order on dispatch
  createdById        String?
  lines              InvoiceLine[]
  payments           Payment[]
  creditNotes        CreditNote[]
  ewayBill           EwayBill?
  createdAt          DateTime      @default(now())

  @@unique([shopId, fy, invoiceNo]) // gapless invoice series, per shop (03 §7, 17)
  @@index([customerId])
  @@index([shopId])
}

model InvoiceLine {
  id           String  @id @default(cuid())
  shopId       String
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String
  saleUnitId   String
  hsnCode      String?
  saleQty      Decimal @db.Decimal(14, 3)
  baseQty      Decimal @db.Decimal(14, 3)
  unitPrice    Decimal @db.Decimal(14, 2) // may be a manual rate override
  lineDiscount Decimal @default(0) @db.Decimal(14, 2)
  taxableValue Decimal @db.Decimal(14, 2) // after discount, before tax (03 §8)
  gstRate      Decimal @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(14, 2)
  sgst         Decimal @default(0) @db.Decimal(14, 2)
  igst         Decimal @default(0) @db.Decimal(14, 2)

  @@index([shopId])
}

model Payment {
  id         String      @id @default(cuid())
  shopId     String
  invoiceId  String?
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id])
  orderId    String?
  customerId String?
  mode       PaymentMode
  amount     Decimal     @db.Decimal(14, 2) // part-payment supported (many per invoice)
  reference  String? // UPI/txn ref / Razorpay paymentId
  date       DateTime    @default(now())

  @@index([invoiceId])
  @@index([shopId])
}

model CreditNote {
  id           String           @id @default(cuid())
  shopId       String
  fy           String
  creditNoteNo String // own gapless series
  invoiceId    String
  invoice      Invoice          @relation(fields: [invoiceId], references: [id])
  reason       String?
  taxableTotal Decimal          @db.Decimal(14, 2)
  cgstTotal    Decimal          @default(0) @db.Decimal(14, 2)
  sgstTotal    Decimal          @default(0) @db.Decimal(14, 2)
  igstTotal    Decimal          @default(0) @db.Decimal(14, 2)
  grandTotal   Decimal          @db.Decimal(14, 2)
  refundMode   String? // CASH | UPI | KHATA_ADJUST | GATEWAY
  lines        CreditNoteLine[]
  createdAt    DateTime         @default(now())

  @@unique([shopId, fy, creditNoteNo]) // gapless credit-note series, per shop (17)
  @@index([shopId])
}

model CreditNoteLine {
  id           String     @id @default(cuid())
  shopId       String
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  productId    String
  saleUnitId   String
  saleQty      Decimal    @db.Decimal(14, 3)
  baseQty      Decimal    @db.Decimal(14, 3)
  taxableValue Decimal    @db.Decimal(14, 2)
  gstRate      Decimal    @db.Decimal(5, 2)

  @@index([shopId])
}

// ──────────────────── Orders & ecommerce (13 §9) ────────────────────
model Order {
  id                 String         @id @default(cuid())
  shopId             String
  orderNo            String
  customerId         String
  customer           Customer       @relation(fields: [customerId], references: [id])
  status             OrderStatus    @default(PENDING_PAYMENT)
  fulfilment         FulfilmentType
  addressId          String?
  placeOfSupplyState String?
  itemTotal          Decimal        @db.Decimal(14, 2)
  deliveryFee        Decimal        @default(0) @db.Decimal(14, 2)
  grandTotal         Decimal        @db.Decimal(14, 2)
  paymentStatus      PaymentStatus  @default(UNPAID)
  razorpayOrderId    String?
  reservations       Reservation[]
  lines              OrderLine[]
  createdAt          DateTime       @default(now())

  @@unique([shopId, orderNo])
  @@index([customerId])
  @@index([status])
  @@index([shopId])
}

model OrderLine {
  id         String  @id @default(cuid())
  shopId     String
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  saleUnitId String
  saleQty    Decimal @db.Decimal(14, 3)
  baseQty    Decimal @db.Decimal(14, 3)
  unitPrice  Decimal @db.Decimal(14, 2)

  @@index([shopId])
}

model ProcessedWebhook {
  // idempotency (03 §9)
  id        String   @id @default(cuid())
  shopId    String? // derived from the matched Order when a webhook is processed (nullable — set post-lookup)
  eventId   String   @unique // Razorpay event id (stays globally unique — gateway-guaranteed)
  paymentId String?
  type      String?
  createdAt DateTime @default(now())

  @@index([shopId])
}

// ──────────────────── Idempotency (04 §5) ────────────────────
// (key, principal, route, requestHash) → stored response, so a retried
// stock-/money-moving create returns the original result instead of repeating the
// effect. Same key + different body → IDEMPOTENCY_MISMATCH (409). First needed by
// GRN in S3 (stock-moving); reused by pakka/convert/place-order/payment/CN.
model IdempotencyKey {
  id          String   @id @default(cuid())
  shopId      String? // not set in P0 — principalId already binds the key to one shop
  key         String
  principalId String // staff or customer id that issued the key
  route       String // logical route, e.g. "POST /api/grn"
  requestHash String // hash of the validated request body
  response    Json // the stored success response (replayed verbatim)
  statusCode  Int      @default(201)
  createdAt   DateTime @default(now())

  @@unique([key, principalId, route])
  @@index([createdAt])
  @@index([shopId])
}

// ──────────────────── e-Way bill (docs/architecture/20) ────────────────────
// Required for moving goods above a value threshold (₹50,000 inter-state; higher in
// some states intra-state) REGARDLESS of turnover — so unlike e-invoicing this applies
// to every shop today. Part-A is the consignment; Part-B is the vehicle. Part-B may be
// filled later, and the bill's validity only starts once it is.
//
// We do NOT call the government API here (that needs GSP credentials + IP whitelisting
// — see doc 20). This records what the shop needs, produces the portal's upload JSON,
// and stores the number once issued.
enum EwayBillStatus {
  DRAFT // captured here, not yet on the portal
  GENERATED // portal issued a number
  CANCELLED // cancelled on the portal (24h window)
}

enum TransportMode {
  ROAD
  RAIL
  AIR
  SHIP
}

model EwayBill {
  id        String         @id @default(cuid())
  shopId    String
  invoiceId String         @unique // one live e-way bill per invoice
  invoice   Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  status    EwayBillStatus @default(DRAFT)

  // ── Part-A: the consignment ──
  /// Value used for the threshold test (paise) — snapshot, so a later edit cannot
  /// retro-justify a missing bill.
  consignmentValue Int
  fromPincode      String
  toPincode        String
  /// Numeric GST state codes, as the portal expects.
  fromStateCode    String
  toStateCode      String
  /// Approximate road distance in km — drives validity.
  distanceKm       Int?

  // ── Part-B: the vehicle (may arrive later) ──
  transportMode    TransportMode?
  vehicleNumber    String?
  /// true = over-dimensional cargo, which validates at 1 day per 20 km, not 200.
  overDimensional  Boolean        @default(false)
  transporterGstin String?
  transporterName  String?
  transportDocNo   String?
  transportDocDate DateTime?

  // ── Portal result ──
  ewbNo           String?
  ewbDate         DateTime?
  validUntil      DateTime?
  cancelledReason String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopId])
  @@index([shopId, status])
}

// ──────────────────── Plans & subscriptions (16 §4a, §8 P4) ────────────────────
// What turns "shops exist" into "shops pay". Deliberately does NOT include a payment
// gateway: a small SaaS operator starts by collecting on UPI or bank transfer and
// recording it, and wiring a gateway is a merchant-onboarding decision, not a schema
// one. SubscriptionPayment below is that ledger, and a gateway can write to it later.

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE // past the period end and unpaid — warned, never cut off mid-sale
  CANCELLED
}

model Plan {
  id                  String  @id @default(cuid())
  /// Stable key used in code (FREE / STARTER / PRO). Names can change; keys cannot.
  key                 String  @unique
  name                String
  /// Monthly price in paise (04 §2). 0 for a free tier.
  pricePaise          Int     @default(0)
  /// null anywhere below means UNLIMITED — absence of a limit, not zero.
  maxProducts         Int?
  maxInvoicesPerMonth Int?
  maxStaff            Int?
  /// Feature switches, e.g. { "storefront": true, "einvoice": false }. JSON so a new
  /// flag does not need a migration; read through a typed accessor in core.
  features            Json?
  isActive            Boolean @default(true)
  sortOrder           Int     @default(0)

  subscriptions Subscription[]
}

model Subscription {
  id     String @id @default(cuid())
  /// One live subscription per shop.
  shopId String @unique
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status           SubscriptionStatus @default(TRIALING)
  /// While set and in the future, the shop is on trial regardless of payment.
  trialEndsAt      DateTime?
  /// Paid up to this moment. Past it with no payment → PAST_DUE.
  currentPeriodEnd DateTime?
  cancelledAt      DateTime?
  /// Free-text for the operator ("moved to annual", "discount agreed").
  notes            String?

  payments  SubscriptionPayment[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([status])
}

/// Money actually received. Recorded by the operator today; a gateway can append here.
model SubscriptionPayment {
  id             String       @id @default(cuid())
  shopId         String
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amountPaise  Int
  /// UPI | BANK | CASH | OTHER — free-form so it is not a migration to add one.
  method       String
  reference    String?
  paidAt       DateTime @default(now())
  /// The period this payment covers, so the ledger explains the period end.
  periodStart  DateTime
  periodEnd    DateTime
  /// PlatformUser who recorded it.
  recordedById String?
  createdAt    DateTime @default(now())

  @@index([shopId])
  @@index([subscriptionId])
}

// ──────────────────── Pre-sale documents (docs/architecture/21) ────────────────────
// myBillBook's Estimate/Quotation, Proforma Invoice and Delivery Challan. All three
// are the SAME document — a party, priced lines, GST maths, a total — differing only
// in what they promise. So they are one table with a `kind`, not three near-copies.
//
// What separates them from Invoice, and why they are NOT rows in it:
//   - They mint NO invoice number. The GST invoice series must stay gapless and
//     mean "a tax invoice exists"; a quotation that never converts must not burn one.
//   - They create NO tax liability, NO ledger entry and NO stock movement. Nothing
//     has been sold yet. Stock moves when the doc is converted and the bill finalises.
//   - They are freely editable and cancellable, which a finalised invoice is not.
enum SalesDocKind {
  QUOTATION // "Estimate / Quotation" — a price offer, usually with a validity date
  PROFORMA // "Proforma Invoice" — a request for advance payment
  DELIVERY_CHALLAN // Rule 55 — goods moving without a tax invoice yet
}

enum SalesDocStatus {
  OPEN
  CONVERTED // a tax invoice was raised from it (convertedInvoiceId)
  CANCELLED
}

/// Own sequence per (shop, kind, FY) so each document type numbers from 1 the way a
/// shopkeeper expects — QT/2026-27/000001 and DC/2026-27/000001 coexist.
model SalesDocCounter {
  shopId String
  kind   SalesDocKind
  fy     String
  lastNo Int          @default(0)

  @@id([shopId, kind, fy])
}

model SalesDoc {
  id     String       @id @default(cuid())
  shopId String
  kind   SalesDocKind
  fy     String
  docNo  String // "QT/2026-27/000012"

  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id])
  /// Snapshots, exactly as on Invoice: the document must reprint as it was handed
  /// over, even if the party is later renamed or their GSTIN corrected.
  customerNameSnap  String?
  customerGstinSnap String?
  customerPhoneSnap String?

  placeOfSupplyState String
  date               DateTime  @default(now())
  /// Quotations only — "Valid till". Past it the doc is shown as expired; it is NOT a
  /// separate status, because expiry is a function of the clock, not of an event.
  validUntil         DateTime?
  notes              String?

  taxableTotal  Decimal @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  cgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  sgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  igstTotal     Decimal @default(0) @db.Decimal(14, 2)
  roundOff      Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @db.Decimal(14, 2)

  status          SalesDocStatus @default(OPEN)
  cancelledReason String?

  /// Set once the document becomes a real bill. Unique: one document cannot be billed
  /// twice, and the invoice can be traced back to what was quoted.
  convertedInvoiceId String?   @unique
  convertedAt        DateTime?

  createdById String?
  lines       SalesDocLine[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([shopId, kind, fy, docNo])
  @@index([shopId, kind, status])
  @@index([shopId, date])
  @@index([customerId])
}

model SalesDocLine {
  id         String   @id @default(cuid())
  shopId     String
  salesDocId String
  salesDoc   SalesDoc @relation(fields: [salesDocId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  saleUnitId String
  hsnCode    String?
  /// Mirrors InvoiceLine field-for-field so conversion is a straight copy and the
  /// print template can render either without a second code path.
  saleQty      Decimal @db.Decimal(14, 3)
  baseQty      Decimal @db.Decimal(14, 3)
  unitPrice    Decimal @db.Decimal(14, 2)
  lineDiscount Decimal @default(0) @db.Decimal(14, 2)
  taxableValue Decimal @db.Decimal(14, 2)
  gstRate      Decimal @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(14, 2)
  sgst         Decimal @default(0) @db.Decimal(14, 2)
  igst         Decimal @default(0) @db.Decimal(14, 2)
  /// Position on the printed document, so a reordered quote reprints in order.
  sortOrder    Int     @default(0)

  @@index([salesDocId])
  @@index([shopId])
}
